# Enhanced ML-Powered Web Scraper - Environment Configuration
# Copy this file to .env and customize the values for your environment

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Python and application settings
PYTHONUNBUFFERED=1
PYTHONPATH=/app
DISPLAY=:99

# Analyzer configuration
ANALYZER_CONFIG_PATH=/app/config/enhanced_analyzer_config.yaml
ANALYZER_DEBUG_LEVEL=INFO
ANALYZER_MODEL_DIR=/app/models

# =============================================================================
# SCRAPING PARAMETERS
# =============================================================================

# Basic scraping settings
MAX_PAGES=50
SCRAPE_INTERVAL=7200
TRAINING_INTERVAL=86400

# Site configurations
DEFAULT_SITE=tokopedia
ENABLE_MULTI_SITE=true
AUTO_TRAIN_MODEL=true

# Data collection
COLLECT_TRAINING_DATA=true
MIN_TRAINING_SAMPLES=100
MAX_TRAINING_SAMPLES=2000

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Chrome browser options (comma-separated)
CHROME_OPTIONS=--no-sandbox,--disable-dev-shm-usage,--disable-gpu,--remote-debugging-port=9222

# ML and processing
ML_WORKERS=2
FEATURE_CACHE_SIZE=1000

# Resource allocation
CONTAINER_CPUS=4.0
CONTAINER_MEMORY=6g
CONTAINER_SHM_SIZE=2g

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
LOG_FEATURE_EXTRACTION=true
SAVE_FEATURE_ANALYSIS=true

# Logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
VERBOSE_LOGGING=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB settings
MONGO_INITDB_ROOT_USERNAME=analyzer
MONGO_INITDB_ROOT_PASSWORD=analyzer_password_2024
MONGO_INITDB_DATABASE=analyzer_db
MONGO_APP_USERNAME=analyzer_app
MONGO_APP_PASSWORD=analyzer_app_password_2024

# Redis settings
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Grafana (for monitoring profile)
GF_SECURITY_ADMIN_PASSWORD=admin_password_2024
GF_USERS_ALLOW_SIGN_UP=false

# Jupyter (for development profile)
JUPYTER_TOKEN=
JUPYTER_PASSWORD=

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Port mappings
ANALYZER_PORT=4000
MONITORING_PORT=8080
CHROME_DEBUG_PORT=9222
MONGODB_PORT=27017
REDIS_PORT=6379
JUPYTER_PORT=8888
GRAFANA_PORT=3000

# Network settings
NETWORK_SUBNET=172.20.0.0/16

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
ENABLE_REDIS_CACHING=true
ENABLE_MONGODB_STORAGE=true
ENABLE_FEATURE_TEMPLATES=true
ENABLE_ENSEMBLE_LEARNING=true
ENABLE_CROSS_VALIDATION=true

# Development features
ENABLE_JUPYTER=false
ENABLE_GRAFANA=false
ENABLE_DEBUG_MODE=false

# =============================================================================
# SITE-SPECIFIC CONFIGURATIONS
# =============================================================================

# Tokopedia
TOKOPEDIA_ENABLED=true
TOKOPEDIA_MAX_PAGES=30
TOKOPEDIA_SCROLL_PAUSE=3

# Amazon
AMAZON_ENABLED=true
AMAZON_MAX_PAGES=25
AMAZON_PAGE_TIMEOUT=25

# Shopee
SHOPEE_ENABLED=true
SHOPEE_MAX_PAGES=40
SHOPEE_SCROLL_PAUSE=2.5

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Model training
AUTO_RETRAIN_THRESHOLD=0.1
MODEL_BACKUP_ENABLED=true
MODEL_VERSION_RETENTION=5

# Data retention
TRAINING_DATA_RETENTION_DAYS=90
SCRAPING_RESULTS_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# Performance optimization
ENABLE_FEATURE_CACHING=true
ENABLE_MODEL_CACHING=true
CACHE_TTL_SECONDS=3600

# Experimental features
ENABLE_EXPERIMENTAL_FEATURES=false
EXPERIMENTAL_FEATURE_LIST=adaptive_thresholds,dynamic_selectors